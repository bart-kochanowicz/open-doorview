#!/bin/sh

daemon=${DOORVIEW_MQTT_DAEMON:-/etc/doorview/doorview-mqtt}
config=${DOORVIEW_MQTT_CONFIG:-/etc/doorview/mqtt.conf}
pidfile=${DOORVIEW_MQTT_PIDFILE:-/tmp/doorview-mqtt.pid}
log=${DOORVIEW_MQTT_LOG:-/tmp/doorview-mqtt.log}

running() {
    [ -r "$pidfile" ] && read -r pid < "$pidfile" || return 1
    case "$pid" in ''|*[!0-9]*) return 1 ;; esac
    kill -0 "$pid" 2> /dev/null || return 1
    # The pid file lives in tmpfs, but make sure the pid still belongs to the daemon.
    [ ! -r "/proc/$pid/cmdline" ] || case "$(tr '\0' ' ' < "/proc/$pid/cmdline")" in
        "$daemon "*) ;;
        *) return 1 ;;
    esac
}

# The camera only has the on-link route of its own subnet. A broker in another subnet needs a default route,
# which the Wi-Fi hook does not set. Optional "gateway=<IPv4>" in the configuration (ignored by the daemon).
ensure_default_route() {
    gateway=$(awk -F= '$1 == "gateway" { value = $2 } END { sub(/\r$/, "", value); print value }' "$config")
    [ -n "$gateway" ] || return 0
    printf '%s\n' "$gateway" | grep -Eq '^([0-9]{1,3}\.){3}[0-9]{1,3}$' || return 0
    [ -z "$(ip route show default 2> /dev/null)" ] || return 0
    ip route add default via "$gateway" || echo "Doorview MQTT: cannot add the default route via $gateway" >&2
}

start() {
    # Not configured yet (no broker address or credentials): do nothing.
    [ -r "$config" ] || return 0
    ensure_default_route
    [ -x "$daemon" ] || return 1
    running && return 0
    nohup "$daemon" "$config" > "$log" 2>&1 < /dev/null &
    echo $! > "$pidfile"
}

stop() {
    running || { rm -f "$pidfile"; return 0; }
    kill -TERM "$pid" || return 1
    for attempt in 1 2 3 4 5; do
        running || break
        sleep 1
    done
    ! running || return 1
    rm -f "$pidfile"
}

case "${1:-}" in
    start) start ;;
    stop) stop ;;
    restart) stop && start ;;
    status) if running; then echo 'Doorview MQTT running'; else echo 'Doorview MQTT stopped'; exit 1; fi ;;
    *) echo "Usage: $0 {start|stop|restart|status}" >&2; exit 2 ;;
esac
